# DFTIKTOK — environment variables (optional)
# Copy to `.env` or set these in your host (Railway → Variables tab dek).

# --- API protection (optional) ---
# If set, /api/parse and /api/download require the header `X-API-Key: <value>`.
# Leave empty for open access.
DFTIKTOK_API_KEY=

# --- Rate limiting (optional) ---
# Max requests per client IP per 60-second window. Default 60.
DFTIKTOK_RATE_LIMIT=60

# --- Search / feed provider (optional) ---
# Empty = use the BUILT-IN scraper (scraper.py, needs Chromium — included in the
# Docker image). Set to an external provider endpoint to use it instead
# (query is appended as ?q=...).
DFTIKTOK_FEED_ENDPOINT=
